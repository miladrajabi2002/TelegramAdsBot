APP_NAME="Exir Ads"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ads_platform
DB_USERNAME=ads_platform
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

ADS_PLATFORM_BRAND="Exir Ads"
ADS_PLATFORM_CHANNEL_USERNAME=
ADS_PLATFORM_SUPPORT_USERNAME=
ADS_PLATFORM_MARKUP_BPS=1500
ADS_PLATFORM_MINIMUM_ORDER_IRR=1000000
ADS_PLATFORM_MIN_TARGET_MEMBERS=1000
ADS_PLATFORM_MAX_CHANNELS_PER_CATEGORY=30
ADS_PLATFORM_TIMEZONE=Asia/Tehran
ADS_PLATFORM_DEMO_MODE=false

# Admin is intentionally not exposed at /admin.
# With this value the login URL becomes:
# https://your-domain.example/jsfiopios5/admin/login
ADMIN_PATH_PREFIX=jsfiopios5/admin

KYC_RETENTION_DAYS=1825
KYC_HMAC_KEY=

# Emergency fallbacks only. Normal pricing always comes from Exir public API.
USD_TO_IRR=600000
GRAM_TO_USD=3.25

# Live market feed: USDT/IRT + TON/USDT via Exir public v2 ticker.
# Each market is cached for exactly 60 seconds by PriceFeedService.
# If one API fails, its persistent last-known-good value is used.
PRICE_FEED_TTL_SECONDS=60
PRICE_MARKUP_USD_PERCENT=5.0
PRICE_MARKUP_TON_PERCENT=2.0
EXIR_USDT_IRT_URL=https://api.exir.io/v2/ticker?symbol=usdt-irt
EXIR_TON_USDT_URL=https://api.exir.io/v2/ticker?symbol=ton-usdt

KYC_SLA_FAST_MINUTES=60
KYC_SLA_MAX_HOURS=24

PROFILE_PHOTO_TTL_SECONDS=21600
CHANNEL_SEARCH_PER_MINUTE=30

APP_SHOW_SPLASH=true
APP_SPLASH_MIN_MS=600

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_INIT_DATA_TTL=300

ZARINPAY_BASE_URL=https://zarinmee.ir/api
ZARINPAY_ACCESS_TOKEN=
ZARINPAY_ENABLED=false
ZARINPAY_MOCK=false
ZARINPAY_TIMEOUT=15
ZARINPAY_PAYMENT_HOSTS=zarinmee.ir
ZARINPAY_FEE_TOLERANCE_PERCENT=10

NOWPAYMENTS_BASE_URL=https://api.nowpayments.io/v1
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_PUBLIC_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_ENABLED=false
NOWPAYMENTS_INVOICE_HOSTS=nowpayments.io

ADMIN_NAME="Platform Owner"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
